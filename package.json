{
  "name": "dhun",
  "version": "1.0.0",
  "description": "DHUN - full-stack music app (No Subscription)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server:dev": "nodemon server.js",
    "client:dev": "vite",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "vite": "^5.4.2"
  }
}
